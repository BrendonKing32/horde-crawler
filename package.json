{
  "name": "horde-crawler",
  "private": true,
  "version": "0.1.0",
  "description": "A top-down co-op horde dungeon crawler for the browser, a spiritual successor to the arcade dungeon crawlers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  }
}
