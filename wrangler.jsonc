// Cloudflare Workers static-assets deploy: serves the Vite build in dist/. No Worker script needed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horde-crawler",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
